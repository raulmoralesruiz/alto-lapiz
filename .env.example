# === Alto el Lápiz — configuración del servidor ===
# Copia este archivo a `.env` (o exporta las variables) para personalizar.

# Puerto e interfaz del servidor de juego (HTTP + WS). Alternativa: 8080
PORT=22019
HOST=0.0.0.0

# Proveedor de IA: llamacpp (recomendado) u ollama
AI_PROVIDER=llamacpp

# URL base del servidor de IA (SIN la ruta /v1/...; el servidor la añade)
#   llama.cpp local:            http://127.0.0.1:9931
#   llama.cpp en otra máquina:  http://192.168.1.3:9931
#   Ollama:                     http://127.0.0.1:11434
AI_URL=http://127.0.0.1:9931

# Nombre del modelo. Con llama.cpp puede ser cualquier valor si solo hay un
# modelo cargado; si hay varios, debe coincidir con el id de /v1/models.
AI_MODEL=llama3.2

# Parámetros de la IA
AI_TEMPERATURE=0.1
AI_TIMEOUT_MS=30000
AI_CONCURRENCY=2
AI_CONFIDENCE_THRESHOLD=0.7
AI_MAX_RETRIES=1

# debug | info | warn | error
LOG_LEVEL=info

# Orígenes WebSocket permitidos (separados por coma). Vacío = sin restricción.
# ALLOWED_ORIGINS=https://mi-dominio.com
